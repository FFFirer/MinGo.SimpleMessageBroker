@page "{topicName}"
@using SimpleMessageBroker.Server.Services
@inject IAdminQueryService AdminQuery
@{
    var topicName = (string)RouteData.Values["topicName"]!;
    ViewData["Title"] = $"Topic: {topicName}";
    var detail = await AdminQuery.GetTopicDetailAsync(Uri.UnescapeDataString(topicName));
}

@if (detail == null)
{
    <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">Topic not found.</p>
        <a href="/ui/topics" class="mt-4 inline-block text-indigo-600 dark:text-indigo-400 hover:underline">Back to Topics</a>
    </div>
    return;
}

<div class="space-y-6">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 dark:text-gray-400">
        <a href="/ui/topics" class="hover:text-indigo-600 dark:hover:text-indigo-400">Topics</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 dark:text-gray-100">@detail.Name</span>
    </nav>

    <!-- Topic Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</p>
            <p class="mt-1">
                @if (detail.IsActive)
                {
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">Active</span>
                }
                else
                {
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400">Inactive</span>
                }
            </p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Partitions</p>
            <p class="text-xl font-bold mt-1">@detail.PartitionCount</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Default TTL</p>
            <p class="text-xl font-bold mt-1">@FormatTtl(detail.DefaultTtlSeconds)</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Created</p>
            <p class="text-sm font-medium mt-1">@detail.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
        </div>
    </div>

    <!-- Message Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Total Messages</p>
            <p class="text-xl font-bold mt-1">@detail.TotalMessages.ToString("N0")</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Pending</p>
            <p class="text-xl font-bold mt-1 text-amber-600 dark:text-amber-400">@detail.PendingMessages.ToString("N0")</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Consumed</p>
            <p class="text-xl font-bold mt-1 text-green-600 dark:text-green-400">@detail.ConsumedMessages.ToString("N0")</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Expired</p>
            <p class="text-xl font-bold mt-1 text-red-600 dark:text-red-400">@detail.ExpiredMessages.ToString("N0")</p>
        </div>
    </div>

    <!-- Partition Depth -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="text-base font-semibold mb-4">Partition Depth</h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-700/50">
                    <tr>
                        <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase whitespace-nowrap">Partition</th>
                        <th class="px-4 py-2 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase whitespace-nowrap">Total</th>
                        <th class="px-4 py-2 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase whitespace-nowrap">Pending</th>
                        <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase whitespace-nowrap">Distribution</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @foreach (var p in detail.Partitions)
                    {
                        var pct = detail.TotalMessages > 0 ? (int)(p.Total * 100.0 / detail.TotalMessages) : 0;
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                            <td class="px-4 py-2 text-sm font-medium whitespace-nowrap">P@(p.Partition)</td>
                            <td class="px-4 py-2 text-sm text-right tabular-nums whitespace-nowrap">@p.Total.ToString("N0")</td>
                            <td class="px-4 py-2 text-sm text-right tabular-nums text-amber-600 dark:text-amber-400 whitespace-nowrap">@p.Pending.ToString("N0")</td>
                            <td class="px-4 py-2">
                                <div class="flex items-center gap-2">
                                    <div class="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-2 max-w-[200px]">
                                        <div class="bg-indigo-500 dark:bg-indigo-400 h-2 rounded-full" style="width: @(pct)%"></div>
                                    </div>
                                    <span class="text-xs text-gray-500 dark:text-gray-400 tabular-nums w-10 text-right">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Consumer Groups -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="text-base font-semibold mb-4">Consumer Groups</h3>
        @if (detail.ConsumerGroups.Count == 0)
        {
            <p class="text-sm text-gray-500 dark:text-gray-400">No consumer groups have consumed from this topic yet.</p>
        }
        else
        {
            <div class="flex flex-wrap gap-2">
                @foreach (var group in detail.ConsumerGroups)
                {
                    <a href="/ui/consumer-groups" class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                        @group
                    </a>
                }
            </div>
        }
    </div>

    <!-- Actions -->
    <div class="flex gap-3">
        <a href="/ui/messages?topic=@Uri.EscapeDataString(detail.Name)" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700 transition-colors">
            Browse Messages
        </a>
        <a href="/ui/topics" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
            Back to Topics
        </a>
        <button data-delete-topic="@detail.Name" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors cursor-pointer">
            Delete Topic
        </button>
    </div>
</div>

@functions {
    string FormatTtl(int seconds)
    {
        if (seconds <= 0) return "Never";
        if (seconds < 3600) return $"{seconds / 60}m";
        if (seconds < 86400) return $"{seconds / 3600}h";
        return $"{seconds / 86400}d";
    }
}

