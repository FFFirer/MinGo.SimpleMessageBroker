@page
@using SimpleMessageBroker.Server.Services
@inject IAdminQueryService AdminQuery
@{
    ViewData["Title"] = "Consumer Groups";
    var groups = await AdminQuery.GetConsumerGroupsAsync();
}

<div class="space-y-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">@groups.Count consumer group(s) found</p>

    @if (groups.Count == 0)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 text-center py-12">
            <p class="text-gray-500 dark:text-gray-400">No consumer groups found. Groups appear when messages are consumed.</p>
        </div>
    }

    @foreach (var group in groups)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30 flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@group.ConsumerGroup</h3>
                <button onclick="deleteGroup('@group.ConsumerGroup')" class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors cursor-pointer">
                    Delete
                </button>
            </div>
            <div class="p-5 space-y-5">

                <!-- Consumers -->
                @if (group.Consumers.Count > 0)
                {
                    <div>
                        <h4 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase mb-2">Consumers (@group.Consumers.Count)</h4>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var consumer in group.Consumers)
                            {
                                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm @(consumer.IsAlive ? "bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300" : "bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300")">
                                    <span class="inline-block w-2 h-2 rounded-full @(consumer.IsAlive ? "bg-green-500" : "bg-red-500")"></span>
                                    <span class="font-mono text-xs" title="@consumer.ConsumerId">@consumer.ConsumerId</span>
                                    @if (consumer.Partitions.Count > 0)
                                    {
                                        <span class="text-xs opacity-70">P[@string.Join(",", consumer.Partitions)]</span>
                                    }
                                    <span class="text-xs opacity-60" title="@consumer.LastHeartbeat.ToString("yyyy-MM-dd HH:mm:ss")">@FormatHeartbeat(consumer.LastHeartbeat)</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Topics & Offsets -->
                @foreach (var topicInfo in group.Topics)
                {
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <a href="/ui/topics/@Uri.EscapeDataString(topicInfo.Topic)" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">@topicInfo.Topic</a>
                            <span class="text-xs text-gray-500 dark:text-gray-400">@topicInfo.Offsets.Count / @topicInfo.PartitionCount partitions consumed</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm">
                                <thead>
                                    <tr class="text-left text-xs text-gray-500 dark:text-gray-400">
                                        <th class="px-3 py-1 font-medium whitespace-nowrap">Partition</th>
                                        <th class="px-3 py-1 font-medium text-right whitespace-nowrap">Consumed</th>
                                        <th class="px-3 py-1 font-medium whitespace-nowrap">Consumer</th>
                                        <th class="px-3 py-1 font-medium whitespace-nowrap">Updated</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                                    @foreach (var offset in topicInfo.Offsets)
                                    {
                                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/20">
                                            <td class="px-3 py-1 tabular-nums whitespace-nowrap">P@(offset.Partition)</td>
                                            <td class="px-3 py-1 text-right tabular-nums whitespace-nowrap">@offset.LastOffset.ToString("N0")</td>
                                            <td class="px-3 py-1 text-gray-500 dark:text-gray-400 whitespace-nowrap">
                                                @if (!string.IsNullOrEmpty(offset.ConsumerId))
                                                {
                                                    <span class="font-mono text-xs" title="@offset.ConsumerId">@TruncateId(offset.ConsumerId)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-400 dark:text-gray-500">-</span>
                                                }
                                            </td>
                                            <td class="px-3 py-1 text-gray-500 dark:text-gray-400 whitespace-nowrap">@offset.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    string FormatHeartbeat(DateTime heartbeat)
    {
        var diff = DateTime.UtcNow - heartbeat;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    string TruncateId(string id)
    {
        return id.Length > 12 ? id[..12] + "…" : id;
    }
}

<script>
async function deleteGroup(name) {
    if (!confirm(`Are you sure you want to delete consumer group "${name}"?\n\nThis will delete all consumer offsets and consumers in this group.\nThe group will auto-recover when a consumer with this group name consumes again.`)) return;
    try {
        const res = await fetch(`/api/v1/admin/consumer-groups/${encodeURIComponent(name)}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            alert(`Consumer group "${name}" deleted. Offsets: ${data.data.deletedOffsets}, Consumers: ${data.data.deletedConsumers}`);
            location.reload();
        } else {
            alert(`Failed: ${data.message}`);
        }
    } catch (e) {
        alert(`Error: ${e.message}`);
    }
}
</script>
