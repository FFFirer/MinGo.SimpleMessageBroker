@page
@using SimpleMessageBroker.Server.Services
@inject IAdminQueryService AdminQuery
@{
    ViewData["Title"] = "Consumer Groups";
    var groups = await AdminQuery.GetConsumerGroupsAsync();
}

<div class="space-y-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">@groups.Count consumer group(s) found</p>

    @if (groups.Count == 0)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 text-center py-12">
            <p class="text-gray-500 dark:text-gray-400">No consumer groups found. Groups appear when messages are consumed.</p>
        </div>
    }

    @foreach (var group in groups)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@group.ConsumerGroup</h3>
            </div>
            <div class="p-5 space-y-4">
                @foreach (var topicInfo in group.Topics)
                {
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <a href="/ui/topics/@Uri.EscapeDataString(topicInfo.Topic)" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">@topicInfo.Topic</a>
                            <span class="text-xs text-gray-500 dark:text-gray-400">@topicInfo.Offsets.Count partition(s)</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm">
                                <thead>
                                    <tr class="text-left text-xs text-gray-500 dark:text-gray-400">
                                        <th class="px-3 py-1 font-medium">Partition</th>
                                        <th class="px-3 py-1 font-medium text-right">Last Offset</th>
                                        <th class="px-3 py-1 font-medium">Updated</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                                    @foreach (var offset in topicInfo.Offsets)
                                    {
                                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/20">
                                            <td class="px-3 py-1 tabular-nums">P@(offset.Partition)</td>
                                            <td class="px-3 py-1 text-right tabular-nums">@offset.LastOffset.ToString("N0")</td>
                                            <td class="px-3 py-1 text-gray-500 dark:text-gray-400">@offset.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
