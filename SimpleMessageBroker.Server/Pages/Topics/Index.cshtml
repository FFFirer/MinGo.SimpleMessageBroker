@page
@using SimpleMessageBroker.Server.Services
@inject IAdminQueryService AdminQuery
@{
    ViewData["Title"] = "Topics";
    var topics = await AdminQuery.GetTopicsAsync();
}

<div class="space-y-5">
    <div class="flex items-center justify-between">
        <p class="text-sm text-gray-500 dark:text-gray-400">@topics.Count topic(s) found</p>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700/50">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Name</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Partitions</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">TTL</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Pending</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Total</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Groups</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Created</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var topic in topics)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                        <td class="px-5 py-3">
                            <a href="/ui/topics/@Uri.EscapeDataString(topic.Name)" class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline">@topic.Name</a>
                        </td>
                        <td class="px-5 py-3">
                            @if (topic.IsActive)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">Active</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400">Inactive</span>
                            }
                        </td>
                        <td class="px-5 py-3 text-right text-sm tabular-nums">@topic.PartitionCount</td>
                        <td class="px-5 py-3 text-right text-sm text-gray-500 dark:text-gray-400 tabular-nums">@FormatTtl(topic.DefaultTtlSeconds)</td>
                        <td class="px-5 py-3 text-right text-sm font-medium text-amber-600 dark:text-amber-400 tabular-nums">@topic.PendingMessages.ToString("N0")</td>
                        <td class="px-5 py-3 text-right text-sm tabular-nums">@topic.TotalMessages.ToString("N0")</td>
                        <td class="px-5 py-3 text-right text-sm tabular-nums">@topic.ConsumerGroupCount</td>
                        <td class="px-5 py-3 text-sm text-gray-500 dark:text-gray-400">@topic.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (topics.Count == 0)
        {
            <div class="text-center py-12 text-gray-500 dark:text-gray-400">
                <p>No topics found.</p>
            </div>
        }
    </div>
</div>

@functions {
    string FormatTtl(int seconds)
    {
        if (seconds <= 0) return "Never";
        if (seconds < 3600) return $"{seconds / 60}m";
        if (seconds < 86400) return $"{seconds / 3600}h";
        return $"{seconds / 86400}d";
    }
}
